prebuilt_etc {
    name: "charger_battery_scale",
    filename: "battery_scale.png",
    src: "images/charger/battery_scale.png",
    relative_install_path: "res/images/charger",
    product_specific: true,
}

prebuilt_etc {
    name: "charger_battery_scale_vendor",
    filename: "battery_scale.png",
    src: "images/charger/battery_scale.png",
    relative_install_path: "res/images/charger",
    proprietary: true,
}

prebuilt_etc {
    name: "charger_battery_fail",
    filename: "battery_fail.png",
    src: "images/charger/battery_fail.png",
    relative_install_path: "res/images/charger",
    product_specific: true,
}

prebuilt_etc {
    name: "charger_battery_fail_vendor",
    filename: "battery_fail.png",
    src: "images/charger/battery_fail.png",
    relative_install_path: "res/images/charger",
    proprietary: true,
}

prebuilt_etc {
    name: "charger_font",
    filename: "main_font.png",
    src: "images/charger/main_font.png",
    relative_install_path: "res/images/charger",
    product_specific: true,
}

prebuilt_etc {
    name: "charger_font_vendor",
    filename: "main_font.png",
    src: "images/charger/main_font.png",
    relative_install_path: "res/images/charger",
    proprietary: true,
}

prebuilt_etc {
    name: "custom_charger_animation",
    filename: "animation.txt",

    required: [
        "charger_battery_fail",
        "charger_battery_scale",
        "charger_font",
    ],
    src: "values/charger/animation.txt",
    relative_install_path: "res/values/charger",
    product_specific: true,
}

prebuilt_etc {
    name: "custom_charger_animation_vendor",
    filename: "animation.txt",

    required: [
        "charger_battery_fail_vendor",
        "charger_battery_scale_vendor",
        "charger_font_vendor",
    ],
    src: "values/charger/animation.txt",
    relative_install_path: "res/values/charger",
    proprietary: true,
}
